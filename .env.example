# Variables de entorno para la app "Forma" (calculadora-ivan)
# Copia este archivo a .env y rellena los valores reales.
# Nunca subas el archivo .env a control de versiones (está en .gitignore).

# Supabase (Auth + DB + RLS)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_KEY=tu-anon-public-key-de-supabase

# Strava OAuth (opcional, solo si se usa sincronización con Strava)
VITE_STRAVA_CLIENT_ID=tu-client-id-de-strava
VITE_STRAVA_CLIENT_SECRET=tu-client-secret-de-strava
VITE_STRAVA_REDIRECT_URI=http://localhost:5173/strava-callback

# Google Gemini (servicio de IA) — OPCIONAL: la app arranca sin esta clave
VITE_GEMINI_API_KEY=tu-api-key-de-gemini

# Piel v2 (OPCIONAL, por defecto v1): `v2` arranca la vista previa. En el navegador
# manda localStorage (`ui`), así que el conmutador de Ajustes puede apagarla.
VITE_UI=v1
